{
  "name": "mkfont2",
  "version": "2.0.0",
  "description": "Modular font editor: build fonts from SVG files and reusable components.",
  "author": {
    "name": "Timothé Lapetite",
    "url": "https://github.com/Nebukam"
  },
  "license": "MIT",
  "homepage": "https://github.com/Nebukam/mkfont",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nebukam/mkfont.git"
  },
  "bugs": {
    "url": "https://github.com/Nebukam/mkfont/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "dev:web": "vite --config vite.preview.config.ts",
    "gen:unicode": "node scripts/gen-unicode.mjs",
    "gen:kerning-pairs": "node scripts/gen-kerning-pairs.mjs",
    "gen:icon": "electron scripts/gen-icon.mjs",
    "check:i18n": "tsx scripts/i18n-literals.ts"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^24.19.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.0.0",
    "happy-dom": "^21.0.4",
    "i18next": "^26.4.7",
    "immer": "^10.1.1",
    "lucide-react": "^1.61.0",
    "opentype.js": "^1.3.4",
    "paper": "0.12.18",
    "postcss": "^8.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.21",
    "svg-path-reverse": "^1.3.0",
    "svg2ttf": "^6.1.0",
    "svgo": "^3.3.2",
    "svgpath": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.1",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.nebukam.mkfont",
    "productName": "MkFont",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "mkfont",
        "name": "MkFont project",
        "description": "MkFont font project",
        "role": "Editor"
      }
    ],
    "afterPack": "scripts/adhoc-sign.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Graphics",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
